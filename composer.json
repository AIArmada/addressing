{
    "name": "aiarmada/addressing",
    "description": "Reusable Laravel address handling package with country reference data, area import contracts, polymorphic address attachment, address snapshots, formatting and normalization",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "addressing",
        "address",
        "countries",
        "areas",
        "normalization"
    ],
    "authors": [
        {
            "name": "AIArmada",
            "email": "dev@aiarmada.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\Addressing\\": "src/",
            "AIArmada\\Addressing\\Database\\Factories\\": "database/factories",
            "AIArmada\\Addressing\\Database\\Seeders\\": "database/seeders"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\Addressing\\AddressingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
